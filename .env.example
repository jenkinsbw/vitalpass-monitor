# Local Postgres from docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://vitalpass:vitalpass@localhost:5433/vitalpass"

# Google Chrome UX Report API key. Required to fetch snapshots.
CRUX_API_KEY=""

# Auth.js session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional overrides for `npm run db:seed` (defaults: admin@vitalpass.local / admin)
# SEED_ADMIN_EMAIL="admin@vitalpass.local"
# SEED_ADMIN_PASSWORD="admin"
# SEED_ADMIN_NAME="Admin"
# SEED_ADMIN_LAST_NAME="User"
