generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FormFactor {
  PHONE
  DESKTOP
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  lastName     String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Site {
  id         String         @id @default(cuid())
  name       String
  origin     String
  formFactor FormFactor
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  snapshots  CruxSnapshot[]

  @@unique([origin, formFactor])
}

model CruxSnapshot {
  id               String   @id @default(cuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  collectedAt      DateTime @default(now())
  lcp              Float?
  inp              Float?
  cls              Float?
  collectionPeriod String
  raw              Json

  @@index([siteId, collectedAt])
}
