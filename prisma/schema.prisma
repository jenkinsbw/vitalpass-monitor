generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FormFactor {
  PHONE
  DESKTOP
}

enum CruxScope {
  ORIGIN
  HOME
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  lastName     String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Site {
  id                  String     @id @default(cuid())
  name                String
  origin              String     @unique
  active              Boolean    @default(true)
  weeklyCheckEnabled  Boolean    @default(false)
  createdAt           DateTime   @default(now())
  snapshots           Snapshot[]
  alerts              Alert[]
}

model Alert {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lcp       Float?
  inp       Float?
  cls       Float?

  @@index([siteId, createdAt])
}

model Snapshot {
  id          String       @id @default(cuid())
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  collectedAt DateTime     @default(now())
  records     CruxRecord[]

  @@index([siteId, collectedAt])
}

model CruxRecord {
  id               String     @id @default(cuid())
  snapshotId       String
  snapshot         Snapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  scope            CruxScope
  formFactor       FormFactor
  url              String?
  lcp              Float?
  inp              Float?
  cls              Float?
  collectionPeriod String?
  error            String?
  raw              Json?

  @@unique([snapshotId, scope, formFactor])
}
